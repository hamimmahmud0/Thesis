# Agent
AGENTS.md

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.eggs/
*.so

# --- Virtualenvs / environments ---
.venv/
venv/
env/

# --- Environment / secrets ---
.env
.env.*
*.token
.hf_token
.huggingface/token
config.yaml
.tokens

# --- Media (large files) ---
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.m4v
*.ts
*.png
*.jpeg
*.jpg
# upper-case extensions (DJI frames are *.JPG and were not matched above)
*.PNG
*.JPEG
*.JPG
*.MP4
*.MOV
# archives / bundles
*.zip
*.tar
*.tar.gz
*.tgz
*.7z

# --- ML artifacts / checkpoints ---
# Ignored by default; weights worth keeping are re-included below and stored with git-lfs (see .gitattributes).
*.pth
*.pt
*.onnx
*.ckpt
*.safetensors
!works/**/models/**/*.pt

# --- Stabilize pipeline outputs ---
tools/stabilize/runs/
tools/stabilize/*.egg-info/
**/tracks.npz
**/motion.npz
**/motion_smooth.npz
runs/
kernels/seg/logs/
kernels/seg/artifacts/

# --- Notebooks ---
.ipynb_checkpoints/
.pytest_cache/

# --- OS / editors ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# dataset
dataset/
# works/b1* (b1, b1.1, b1_small_annotated, b1_labelstudio, ...): the images are ignored by extension above and live in HF buckets /
# Label Studio; the small label files, X-AnyLabeling json, classes/yaml and Label Studio configs in those folders ARE committed.
# Bulk regenerable visualisation folders (also *.jpg, ignored above) are listed explicitly in case other extensions appear:
works/*/viz_*/

# KaggleManager runtime state (contains VM passwords)
mcps/KaggleManager/state.json

# --- Credentials that must never be committed ---
ls_refresh.txt
ls_tok*.txt
*refresh_token*
*.pem
id_rsa*
id_ed25519*
