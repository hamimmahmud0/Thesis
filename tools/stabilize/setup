#!/usr/bin/env bash
# Install the stabilize pipeline (CoTracker3 + CLI) into a conda env.
#
# Usage:
#   ./setup                 # full install
#   SKIP_TORCH=1 ./setup    # reuse an existing torch in the env
#   ENV_NAME=foo ./setup    # custom env name (default: stabilize)
set -euo pipefail

# ──── Configuration ───────────────────────────────────────────────────────────
ENV_NAME="${ENV_NAME:-stabilize}"
PYTHON_VERSION="${PYTHON_VERSION:-3.11}"
# NOTE: deliberately not named CUDA_VERSION -- many GPU containers export that
# already (e.g. CUDA_VERSION=12.8.1), which would break the conda spec below.
PYTORCH_CUDA_VERSION="${PYTORCH_CUDA_VERSION:-12.4}"
MINICONDA_URL="https://repo.anaconda.com/miniconda/Miniconda3-latest-Linux-x86_64.sh"
MINICONDA_INSTALL_DIR="${MINICONDA_INSTALL_DIR:-$HOME/miniconda3}"
COTRACKER_REPO="git+https://github.com/facebookresearch/co-tracker.git"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# ──── Colour helpers ──────────────────────────────────────────────────────────
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'
info()  { echo -e "${GREEN}[INFO]${NC}  $*"; }
warn()  { echo -e "${YELLOW}[WARN]${NC}  $*"; }
error() { echo -e "${RED}[ERROR]${NC} $*" >&2; }

# ──── 1. Locate or install conda ─────────────────────────────────────────────
find_conda() {
    local candidates=(
        conda
        "$HOME/miniconda3/bin/conda"
        "$HOME/anaconda3/bin/conda"
        "/opt/conda/bin/conda"
        "/opt/miniconda3/bin/conda"
    )
    for c in "${candidates[@]}"; do
        if command -v "$c" &>/dev/null || [ -x "$c" ]; then
            echo "$c"
            return 0
        fi
    done
    return 1
}

install_miniconda() {
    info "conda not found — installing Miniconda headlessly ..."
    local installer="/tmp/miniconda_installer.sh"
    if [ ! -f "$installer" ]; then
        curl -fsSL "$MINICONDA_URL" -o "$installer"
    fi
    bash "$installer" -b -p "$MINICONDA_INSTALL_DIR"
    rm -f "$installer"
    "$MINICONDA_INSTALL_DIR/bin/conda" init
    info "Miniconda installed -> $MINICONDA_INSTALL_DIR"
}

CONDA_BIN=""
if CONDA_BIN="$(find_conda)"; then
    info "conda found: $CONDA_BIN"
    eval "$("$CONDA_BIN" shell.bash hook 2>/dev/null || true)"
else
    install_miniconda
    CONDA_BIN="$MINICONDA_INSTALL_DIR/bin/conda"
fi

CONDA_BASE="$("$CONDA_BIN" info --base)"
# shellcheck disable=SC1091
source "$CONDA_BASE/etc/profile.d/conda.sh"

# Accept Anaconda ToS (no-op on older conda versions).
conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/main || true
conda tos accept --override-channels --channel https://repo.anaconda.com/pkgs/r || true

# ──── 2. Create / activate the environment ───────────────────────────────────
if conda env list | grep -qw "$ENV_NAME"; then
    info "conda env '$ENV_NAME' already exists — keeping as-is"
else
    info "Creating conda env '$ENV_NAME' (python $PYTHON_VERSION) ..."
    conda create -n "$ENV_NAME" "python=$PYTHON_VERSION" -y
fi

conda activate "$ENV_NAME"
info "Activated: $(python --version) @ $(which python)"

conda install -y -c conda-forge "mkl=2024.0.0" >/dev/null

# ──── 3. Install PyTorch + CUDA (idempotent) ─────────────────────────────────
TORCH_VER=$(python -c "import torch; print(torch.__version__)" 2>/dev/null || true)
if [ -n "$TORCH_VER" ]; then
    info "PyTorch already installed: $TORCH_VER"
elif [ "${SKIP_TORCH:-0}" = "1" ]; then
    warn "SKIP_TORCH=1 but torch is missing — continuing anyway"
else
    info "Installing PyTorch + CUDA $PYTORCH_CUDA_VERSION via conda ..."
    if ! conda install -y -n "$ENV_NAME" \
        pytorch torchvision "pytorch-cuda=$PYTORCH_CUDA_VERSION" \
        -c pytorch -c nvidia; then
        warn "conda PyTorch install failed — falling back to pip wheels (cu124)"
        pip install torch torchvision \
            --index-url https://download.pytorch.org/whl/cu124
    fi
fi

# ──── 4. Install Python requirements (incl. CoTracker3 from git) ─────────────
REQUIREMENTS="$SCRIPT_DIR/requirements.txt"
if [ ! -f "$REQUIREMENTS" ]; then
    error "requirements.txt not found at $REQUIREMENTS"
    exit 1
fi
info "Installing pip requirements from $REQUIREMENTS ..."
pip install --upgrade pip
pip install -r "$REQUIREMENTS"

# Belt-and-braces: ensure CoTracker3 is importable even if the requirement
# line above was removed or failed silently.
if ! python -c "import cotracker" >/dev/null 2>&1; then
    warn "cotracker not importable — installing from $COTRACKER_REPO"
    pip install "$COTRACKER_REPO"
fi

# ──── 5. Install the stabilize CLI (editable) ────────────────────────────────
info "Installing stabilize (editable) ..."
pip install -e "$SCRIPT_DIR"

# ──── 6. Verify ──────────────────────────────────────────────────────────────
info "Running smoke test ..."
if ! stabilize --help >/dev/null 2>&1; then
    error "stabilize --help failed — check output above"
    exit 1
fi
python - <<'PY'
import cotracker, stabilize  # noqa: F401
from cotracker.predictor import CoTrackerOnlinePredictor  # noqa: F401
print("cotracker + stabilize import OK")
PY

echo ""
info "===== SETUP COMPLETE ====="
info "Activate with:  conda activate $ENV_NAME"
info "CLI:            $(which stabilize)"
