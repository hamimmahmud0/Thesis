#!/usr/bin/env bash

set -euo pipefail

KERNEL_ID=$(python3 <<'PY'
import yaml

with open("config.yaml", "r", encoding="utf-8") as f:
    data = yaml.safe_load(f)

print(data["ID"])
PY
)

export KERNEL_ID

echo "Kernel ID: $KERNEL_ID"

TMP_DIR="/tmp/$KERNEL_ID-$(date +%Y%m%d-%H%M%S)"

mkdir $TMP_DIR
cp -a ./* $TMP_DIR
cd $TMP_DIR

if [[ -f config.py && -f main.py ]]; then
    cat config.py main.py > push.py
    echo "Built push.py from config.py + main.py"
fi

