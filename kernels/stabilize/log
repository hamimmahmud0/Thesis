#!/usr/bin/env bash

# -------------------------
# Kaggle auth
# -------------------------


KERNEL_ID=$(python3 <<'PY'
import yaml

with open("config.yaml", "r", encoding="utf-8") as f:
    data = yaml.safe_load(f)

print(data["ID"])
PY
)


if [[ -f config.yaml ]]; then
    eval "$(python3 - config.yaml <<'PY'
import sys, yaml, shlex
with open(sys.argv[1]) as f:
    cfg = yaml.safe_load(f) or {}
val = cfg.get("KAGGLE_API_TOKEN")
if val:
    print(f"export KAGGLE_API_TOKEN={shlex.quote(str(val))}")
PY
)"
fi

if [[ -n "${KAGGLE_API_TOKEN:-}" ]]; then
    export KAGGLE_API_TOKEN
    echo "Authenticating with KAGGLE_API_TOKEN"
fi

USERNAME=$(kaggle config view | awk -F': ' '/^- username:/ {print $2}')
kaggle kernels logs -f $USERNAME/$KERNEL_ID 